{
  "name": "@developer-overheid-nl/don-checker",
  "version": "1.2.0",
  "packageManager": "pnpm@10.34.5",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/developer-overheid-nl/don-checker"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "don-checker": "./dist/cli.mjs"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && pnpm run build:cli && vite build",
    "build:cli": "build-cli src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "prettier": "@geonovum/standards-checker/prettier",
  "dependencies": {
    "@geonovum/standards-checker": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@asyncapi/specs": "6.11.1"
  },
  "pnpm": {
    "overrides": {
      "@asyncapi/specs": "6.11.1"
    }
  }
}
